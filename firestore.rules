rules_version = '2';

// All Firestore access goes through the Express backend via the Admin SDK,
// which bypasses these rules entirely — the client never talks to Firestore
// directly, only to Firebase Auth. Deny all direct client access by default.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
