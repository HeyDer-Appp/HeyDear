PORT=3100
# Public URL of this form (used for Stripe return_url)
BASE_URL=http://localhost:3100

# ---- Google Sheets, EASIEST: Apps Script web app (see apps-script/Code.gs) ----
GOOGLE_SCRIPT_URL=
GOOGLE_SCRIPT_SECRET=

# ---- Google Sheets, ALTERNATIVE: service account (leave the two lines above empty) ----
# 1. Google Cloud console -> enable "Google Sheets API" -> create a service account -> add a JSON key
# 2. Create a Google Sheet, copy its ID (the long part of the URL), and SHARE the sheet with the service account's client_email as Editor
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Responses
# Either a path to the downloaded JSON key file...
GOOGLE_SERVICE_ACCOUNT_JSON=./data/service-account.json
# ...or (for hosts that only take env vars) these two instead:
# GOOGLE_CLIENT_EMAIL=
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---- Stripe (leave empty to run checkout in test mode without charging) ----
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=nzd
# amounts in cents (same defaults as the HeyDer app)
STRIPE_ONE_TIME_AMOUNT=1000
STRIPE_SUBSCRIPTION_AMOUNT=1500
SKIP_DISCOUNT_PERCENT=10
