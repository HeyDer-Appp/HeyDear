VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_API_URL=http://localhost:3001
# Same VAPID_PUBLIC_KEY from server/.env
VITE_VAPID_PUBLIC_KEY=

# Firebase (client SDK) — from Firebase Console → Project Settings → General
# → Your apps → SDK setup and configuration. These are public identifiers
# (safe to ship in the client bundle) — access is enforced by Firestore
# security rules and the backend's ID-token verification, not by keeping
# these secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_APP_ID=

# Local dev only: point at the Firebase Local Emulator Suite's Auth emulator
# instead of a real project (run `firebase emulators:start` first).
# VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
