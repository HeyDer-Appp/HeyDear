# Firebase (Admin SDK — Firestore + Auth)
# Generate a service account key in Firebase Console → Project Settings →
# Service Accounts → Generate new private key, then copy the three fields
# below. Paste the private key with literal "\n" for line breaks (that's how
# Render/Railway's env var UI stores it) — the app un-escapes it at startup.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Local dev only: point the Admin SDK at the Firebase Local Emulator Suite
# instead of a real project (run `firebase emulators:start` first).
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_ONE_TIME_AMOUNT=1000
STRIPE_SUBSCRIPTION_AMOUNT=1500
STRIPE_CURRENCY=nzd

# Email (choose one)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...

# OR Nodemailer (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@heyder.nz
SMTP_PASS=your-smtp-password
EMAIL_FROM=HeyDer <info@heyder.nz>

# Typeform (historical import only)
TYPEFORM_API_KEY=your-typeform-personal-access-token
TYPEFORM_FORM_ID=OAxjrKyW

# App
NODE_ENV=development
PORT=3001
CLIENT_URL=http://localhost:5173

# Push Notifications (Web Push / PWA)
# Generate with: cd server && npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Referral
REFERRAL_BASE_URL=https://heyder.nz

# Portal reveal timing (minutes after a table is confirmed)
# Defaults in code are the real production values (2880 = 48h glimpse, 1440 = 24h venue).
# Only override with short values for local/manual testing — never in production.
GLIMPSE_REVEAL_MINUTES=2880
VENUE_REVEAL_MINUTES=1440

# Render deployment
# These will be set by the platform automatically / filled in the dashboard
